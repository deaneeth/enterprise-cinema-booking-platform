# .env.example - Backend environment variables template
# Copy this file to .env and fill in the actual values
# This file contains example environment variable configurations for the backend
# Examples: DATABASE_URL, JWT_SECRET, PORT, etc.

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://admin:password123@localhost:27017/cinema-booking?authSource=admin

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=24h

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# PayPal Configuration (Member 7)
# Note: These credentials will be provided by the project leader
# Get sandbox credentials from: https://developer.paypal.com/
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox