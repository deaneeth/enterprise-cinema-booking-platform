# .env.example - Frontend environment variables template
# Copy this file to .env and fill in the actual values
# This file contains example environment variable configurations for the frontend

# Backend API URL
REACT_APP_BACKEND_URL=http://localhost:5000

# WebSocket URL
REACT_APP_WEBSOCKET_URL=http://localhost:5000

# Development Hot-Reload
CHOKIDAR_USEPOLLING=true

# =============================================================================
# PayPal Configuration (Member 7)
# =============================================================================
# PayPal Client ID for payment processing
# Get this from PayPal Developer Dashboard: https://developer.paypal.com
# Note: Only the Client ID is exposed to frontend, NEVER expose the secret
REACT_APP_PAYPAL_CLIENT_ID=your_paypal_client_id_here